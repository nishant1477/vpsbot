[Unit]
Description=Arqon Host — Web Dashboard
After=network.target arqon-bot.service

[Service]
Type=simple
User=arqon
WorkingDirectory=/opt/arqon-host/dashboard
Environment=PATH=/opt/arqon-host/venv/bin
ExecStart=/opt/arqon-host/venv/bin/gunicorn --bind 0.0.0.0:5000 --workers 4 app:app
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
